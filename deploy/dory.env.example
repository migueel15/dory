# Secretos de dory. Instálalo como ~/.config/dory/dory.env con permisos 600.
# Lo leen la unidad systemd, el backup y `docker compose --env-file`.

# Contraseña de Postgres (docker-compose.yml).
POSTGRES_PASSWORD=cambiame
# POSTGRES_PORT=5432

# Debe usar la misma contraseña que POSTGRES_PASSWORD.
DORY_DATABASE_URL=postgres://dory:cambiame@127.0.0.1:5432/dory?sslmode=disable

# Origen público por HTTPS si accedes detrás de un proxy o de Cloudflare Tunnel.
# Déjalo comentado si accedes directamente por HTTP.
# DORY_PUBLIC_ORIGIN=https://dory.dorlab.net
