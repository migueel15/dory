[Unit]
Description=Despliegue de dory desde origin/main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=miguel
Environment=PATH=/home/miguel/.local/go/bin:/home/miguel/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/miguel/.local/bin/dory-deploy
TimeoutStartSec=15min
